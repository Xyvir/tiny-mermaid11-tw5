type: application/json
tags: $:/tags/ControlPanel/Settings

{
    "startOnLoad": false,
    "securityLevel": "loose",
    "theme": "default",
    "look": "classic",
    "fontFamily": "sans-serif",
    "themeVariables": {
        "lineColor": "#d3d3d3",
