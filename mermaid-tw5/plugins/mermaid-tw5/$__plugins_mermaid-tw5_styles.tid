title: $:/plugins/orange/mermaid-tw5/styles
tags: $:/tags/Stylesheet

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

/* ── Hide stray Mermaid error SVGs ── */
svg[aria-roledescription="error"],
svg.error-icon,
svg:has(.error-icon) {
    display: none !important;
}

/* ── Node fills & borders ── */
.node rect,
.node polygon,
.node circle,
.node ellipse,
.node path {
    fill: <<colour muted-foreground>> !important;
    stroke: <<colour primary>> !important;
    stroke-width: 1.5px !important;
}

/* ── Node text (inside filled nodes) ── */
.node .label,
.node text,
.node tspan,
.node foreignObject div,
.node foreignObject span {
    fill: <<colour tiddler-background>> !important;
    color: <<colour tiddler-background>> !important;
}

/* ── Edge lines ── */
.edgePath .path,
.edge-path path,
.flowchart-link,
path.path,
.link,
g.edgePaths path {
    stroke: <<colour foreground>> !important;
    stroke-width: 1.5px !important;
}

/* ── Arrowhead markers ── */
marker path {
    fill: <<colour foreground>> !important;
    stroke: <<colour foreground>> !important;
}

/* ── Edge labels ── */
.edgeLabel,
.edgeLabel text,
.edgeLabel tspan,
.edgeLabel foreignObject div,
.edgeLabel foreignObject span,
.label text,
.label tspan {
    fill: <<colour foreground>> !important;
    color: <<colour foreground>> !important;
}

/* ── Subgraph / cluster ── */
.cluster rect {
    fill: <<colour page-background>> !important;
    stroke: <<colour muted-foreground>> !important;
}
.cluster text,
.cluster tspan {
    fill: <<colour foreground>> !important;
}
